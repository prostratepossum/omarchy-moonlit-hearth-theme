# Moonlit Hearth btop theme. Transparent background; graphs climb from night
# blue at idle through moonlight to hearth amber, with ember at the very top.

theme[main_bg]=""
theme[main_fg]="#d4e3f0"
theme[title]="#f0c47a"
theme[hi_fg]="#8fbbe0"
theme[selected_bg]="#1a2c45"
theme[selected_fg]="#f7d9a0"
theme[inactive_fg]="#5d7590"
theme[graph_text]="#a3b9cc"
theme[meter_bg]="#14243a"
theme[proc_misc]="#a99ad8"

# Box outlines: moonlight, frost, lavender, snow
theme[cpu_box]="#8fbbe0"
theme[mem_box]="#8fb9a8"
