[Plymouth Theme]
Name=Moonlit Hearth
Description=Moonlit Hearth splash: snowy moonlit night, falling snow, cabin badge in a breathing moon halo.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/hearth
ScriptFile=/usr/share/plymouth/themes/hearth/hearth.script
ConsoleLogBackgroundColor=0x0a1424
MonospaceFont=Cantarell 11
Font=Cantarell 11
