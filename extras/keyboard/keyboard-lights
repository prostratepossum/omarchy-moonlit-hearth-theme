        ecodes.KEY_APOSTROPHE: "Key: '",
        ecodes.KEY_COMMA: "Key: ,",
        ecodes.KEY_DOT: "Key: .",
        ecodes.KEY_SLASH: "Key: /",
        ecodes.KEY_SYSRQ: "Key: Print Screen",
        ecodes.KEY_SCROLLLOCK: "Key: Scroll Lock",
        ecodes.KEY_PAUSE: "Key: Pause/Break",
        ecodes.KEY_INSERT: "Key: Insert",
        ecodes.KEY_DELETE: "Key: Delete",
        ecodes.KEY_HOME: "Key: Home",
        ecodes.KEY_END: "Key: End",
        ecodes.KEY_PAGEUP: "Key: Page Up",
        ecodes.KEY_PAGEDOWN: "Key: Page Down",
        ecodes.KEY_UP: "Key: Up Arrow",
        ecodes.KEY_DOWN: "Key: Down Arrow",
        ecodes.KEY_LEFT: "Key: Left Arrow",
        ecodes.KEY_RIGHT: "Key: Right Arrow",
    }
    if hasattr(ecodes, "KEY_FN"):
        mapping[ecodes.KEY_FN] = "Key: Right Fn"
    for i in range(1, 13):
        mapping[getattr(ecodes, f"KEY_F{i}")] = f"Key: F{i}"
    for ch in "abcdefghijklmnopqrstuvwxyz":
        mapping[getattr(ecodes, f"KEY_{ch.upper()}")] = f"Key: {ch.upper()}"
    for n in range(10):
        mapping[getattr(ecodes, f"KEY_{n}")] = f"Key: {n}"
    return mapping


def acquire_lock() -> object:
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/tmp/user-{os.getuid()}")
    os.makedirs(runtime, exist_ok=True)
    lock_file = open(os.path.join(runtime, "keyboard-lights.lock"), "w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("keyboard-lights already running")
        raise SystemExit(0)
    return lock_file


def run_once(client: str | None = None) -> None:
    last_error = "Keyboard not found"
    for attempt in range(1, 6):
        try:
            apply_cli(pick_keyboard(list_devices(client)), client)
            return
        except SystemExit as exc:
            last_error = str(exc)
            if attempt == 5:
                raise
            time.sleep(2)
    raise SystemExit(last_error)


def run_daemon(port: int) -> None:
    server = start_server(port)
    try:
        sdk = OpenRGBClient(port=port)
        sdk.connect()
        kb_id = None
        kb_name = ""
        deadline = time.time() + 30
        while time.time() < deadline and kb_id is None:
            try:
                count = sdk.controller_count()
            except Exception:
                time.sleep(0.4)
                continue
            for idx in range(count):
                name = sdk.controller_name(idx)
                if DEVICE_MATCH in name.lower():
                    kb_id = idx
                    kb_name = name
                    break
            if kb_id is None:
                time.sleep(0.4)
        if kb_id is None:
            raise SystemExit("OpenRGB server did not expose the BlackWidow keyboard")

        pal = current_palette()
        stamp = theme_stamp()
        rest = [color_for(name, pal) for name in MATRIX_LEDS]
        current = list(rest)
        hits = [0.0] * len(rest)
        name_to_index = {name: i for i, name in enumerate(MATRIX_LEDS) if name}

        def flickers(p: dict) -> list[bool]:
            return [bool(n) and ROW_OF.get(n, -1) in p["flicker_rows"]
                    and n not in SNOWCAP_KEYS and n not in FIREFLY_KEYS and n not in p["special"]
                    for n in MATRIX_LEDS]

        def twinkles(p: dict) -> list[bool]:
            return [bool(n) and p.get("twinkle", False)
                    and n not in SNOWCAP_KEYS and n not in FIREFLY_KEYS and n not in p["special"]
                    for n in MATRIX_LEDS]

        flick = flickers(pal)
        twink = twinkles(pal)
        flakes = [0.0] * len(rest)
        print(f"Set {kb_name}: {summary(rest, pal)} ({len(rest)} LEDs)", flush=True)
        sdk.set_custom_mode(kb_id)
        sdk.update_leds(kb_id, [pal["hit"]] * len(rest))
        time.sleep(0.12)
        sdk.update_leds(kb_id, current)

        try:
            from evdev import ecodes

            codes = keycode_map()
            input_devs = find_keyboard_devices()
        except Exception as exc:
            print(
                f"Reactive typing unavailable ({exc}); keeping static lighting",
                flush=True,
            )
            codes = {}
            input_devs = []

        fd_to_dev = {d.fd: d for d in input_devs}
        if input_devs:
            print(
                "Reactive typing on "
                + ", ".join(f"{d.path} ({d.name})" for d in input_devs),
                flush=True,
            )

        dirty = False
        next_theme_check = 0.0
        next_flicker = 0.0
        next_twinkle = 0.0
        twinkle_keys = [i for i, on in enumerate(twink) if on]
        while True:
            now = time.time()
            # Follow theme switches (cheap stat once a second).
            if now >= next_theme_check:
                next_theme_check = now + 1.0
                new_stamp = theme_stamp()
                if new_stamp != stamp:
                    stamp = new_stamp
                    pal = current_palette()
                    rest = [color_for(name, pal) for name in MATRIX_LEDS]
                    flick = flickers(pal)
                    twink = twinkles(pal)
                    flakes = [0.0] * len(rest)
                    twinkle_keys = [i for i, on in enumerate(twink) if on]
                    current = list(rest)
                    hits = [0.0] * len(rest)
                    print(f"Theme changed: {summary(rest, pal)}", flush=True)
                    dirty = True
            if fd_to_dev:
                ready, _, _ = select.select(list(fd_to_dev), [], [], FRAME_DT)
            else:
                time.sleep(FRAME_DT)
                ready = []
            for fd in ready:
                dev = fd_to_dev[fd]
                try:
                    events = list(dev.read())
                except (BlockingIOError, OSError):
                    continue
                for event in events:
                    if event.type != ecodes.EV_KEY or event.value not in (1, 2):
                        continue
                    name = codes.get(event.code)
                    idx = name_to_index.get(name) if name else None
                    if idx is None:
                        continue
                    hits[idx] = now
                    current[idx] = hit_color(rest[idx], pal)
                    dirty = True
            # Optional row flicker at ~15 fps (off for this palette).
            flicker_now = any(flick) and now >= next_flicker
            if flicker_now:
                next_flicker = now + 1 / 15
            # Snowfall twinkle at ~12 fps (hearth only).
            twinkle_now = bool(twinkle_keys) and now >= next_twinkle
            if twinkle_now:
                next_twinkle = now + TWINKLE_DT
                if random.random() < TWINKLE_CHANCE:
                    flakes[random.choice(twinkle_keys)] = now
            for i, stamped in enumerate(hits):
                if stamped <= 0:
                    if flicker_now and flick[i]:
                        current[i] = scale(rest[i], flicker_gain(i % ROW_WIDTH, now))
                        dirty = True
                    elif twinkle_now and flakes[i] > 0:
                        ft = (now - flakes[i]) / TWINKLE_SECONDS
                        if ft >= 1:
                            current[i] = rest[i]
                            flakes[i] = 0.0
                        else:
                            current[i] = lerp(rest[i], SNOW_FLARE, TWINKLE_PEAK * math.sin(math.pi * ft))
                        dirty = True
                    continue
                t = (now - stamped) / FADE_SECONDS
                if t >= 1:
                    current[i] = rest[i]
                    hits[i] = 0.0
                else:
                    current[i] = lerp(hit_color(rest[i], pal), rest[i], t)
                dirty = True
            if dirty:
                sdk.update_leds(kb_id, current)
                dirty = False
    finally:
        if server is not None:
            server.terminate()
            try:
                server.wait(timeout=5)
            except subprocess.TimeoutExpired:
                server.kill()


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="Apply colors and exit")
    parser.add_argument("--daemon", action="store_true", help="Run reactive lighting")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args()
    _lock = acquire_lock()
    if args.once:
        run_once()
        return
    run_daemon(args.port)


if __name__ == "__main__":
    main()
