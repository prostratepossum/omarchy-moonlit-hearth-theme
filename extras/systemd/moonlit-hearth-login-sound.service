[Unit]
Description=Moonlit Hearth winter chime at login
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=oneshot
# Let the desktop and audio settle before the chime plays.
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/pw-play %h/.config/omarchy/themes/moonlit-hearth/sounds/hearth-login.wav

[Install]
WantedBy=graphical-session.target
